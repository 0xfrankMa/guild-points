.container { padding: 20rpx; }

.user-card {
  background: linear-gradient(135deg, #FFD93D 0%, #F5A623 50%, #FF8C00 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  color: #4A3728;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  border: 3rpx solid #D4850D;
  box-shadow: 0 8rpx 28rpx rgba(245,166,35,0.3);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255,255,255,0.4);
}
.user-avatar-default {
  font-size: 64rpx;
  background: rgba(255,255,255,0.3);
  text-align: center;
  line-height: 96rpx;
}

.user-info { flex: 1; }
.user-name { display: block; font-size: 36rpx; font-weight: bold; }
.user-role { font-size: 24rpx; opacity: 0.7; }
.user-points { text-align: right; }
.points-num { display: block; font-size: 52rpx; font-weight: bold; text-shadow: 2rpx 2rpx 0 rgba(255,255,255,0.3); }
.points-label { font-size: 22rpx; opacity: 0.7; }

.nickname-card {
  background: #FFFDF5;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #F0D68A;
}
.nickname-row { flex: 1; }
.nickname-label { display: block; font-size: 22rpx; color: #8B6914; margin-bottom: 6rpx; }
.nickname-value { font-size: 30rpx; color: #4A3728; font-weight: 500; }
.nickname-input {
  font-size: 30rpx; color: #4A3728; border-bottom: 2rpx solid #F5A623;
  padding: 4rpx 0; width: 100%;
}
.btn-edit-nickname {
  background: #FFF8E7 !important; color: #8B6914 !important;
  border: 2rpx solid #F0D68A !important; border-radius: 30rpx !important;
  font-size: 24rpx !important; flex-shrink: 0; margin-left: 16rpx;
}
.btn-save-nickname {
  background: linear-gradient(135deg, #FFD93D, #F5A623) !important;
  color: #4A3728 !important; font-weight: bold !important;
  border: 2rpx solid #D4850D !important; border-radius: 30rpx !important;
  font-size: 24rpx !important; flex-shrink: 0; margin-left: 16rpx;
}

.checkin-card {
  background: linear-gradient(135deg, #FFFDF5, #FFF3D6);
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 20rpx;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.1);
  overflow: hidden;
}
.checkin-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
}
.checkin-edit {
  border-top: 2rpx solid #F0D68A;
  padding: 14rpx 32rpx;
  text-align: center;
  background: rgba(245,166,35,0.06);
}
.checkin-edit-text { font-size: 22rpx; color: #8B6914; }
.checkin-left { display: flex; align-items: center; gap: 20rpx; }
.checkin-icon { font-size: 56rpx; }
.checkin-title { display: block; font-size: 30rpx; font-weight: bold; color: #4A3728; }
.checkin-desc { display: block; font-size: 22rpx; color: #8B6914; margin-top: 4rpx; }
.checkin-right { text-align: center; }
.checkin-streak { display: block; font-size: 20rpx; color: #F5A623; margin-bottom: 6rpx; }
.checkin-btn {
  display: inline-block;
  background: linear-gradient(135deg, #FFD93D, #F5A623);
  color: #4A3728;
  font-weight: bold;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  border: 2rpx solid #D4850D;
}
.checkin-btn.done {
  background: #E8E0D0;
  color: #8B7D6B;
  border-color: #C9B98A;
}

.stats-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }

.stat-card {
  flex: 1;
  background: #FFFDF5;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 12rpx rgba(139,105,20,0.08);
}

.stat-num { display: block; font-size: 40rpx; font-weight: bold; color: #F5A623; }
.stat-label { font-size: 24rpx; color: #8B6914; }

.section-header { margin-top: 20rpx; margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #4A3728; }

.rank-list { background: #FFFDF5; border-radius: 24rpx; overflow: hidden; border: 2rpx solid #F0D68A; }

.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid #F0D68A;
}

.rank-item:last-child { border-bottom: none; }

.rank-medal {
  width: 56rpx;
  font-size: 32rpx;
  text-align: center;
  font-weight: bold;
  color: #8B6914;
}

.rank-name { flex: 1; font-size: 28rpx; color: #4A3728; }
.rank-points { font-size: 28rpx; color: #FF8C00; font-weight: 500; }

.invite-card {
  background: linear-gradient(135deg, #FFFDF5, #FFF3D6);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #F0D68A;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.1);
}

.invite-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.invite-icon { font-size: 40rpx; }
.invite-title { font-size: 30rpx; font-weight: bold; color: #4A3728; }

.invite-code-box {
  background: #FFFDF5;
  border: 2rpx dashed #D4850D;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.invite-code-label { font-size: 24rpx; color: #8B6914; }
.invite-code-value { font-size: 36rpx; font-weight: bold; color: #D4850D; letter-spacing: 6rpx; }

.invite-btns { display: flex; gap: 16rpx; }

.btn-copy-new {
  flex: 1;
  background: #FFFDF5 !important;
  color: #4A3728 !important;
  font-weight: bold !important;
  font-size: 26rpx !important;
  border-radius: 40rpx !important;
  height: 76rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #D4850D !important;
}

.danger-zone {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #F0D68A;
}
.btn-leave {
  background: #FFFDF5 !important;
  color: #E74C3C !important;
  font-size: 28rpx !important;
  border: 2rpx solid #E74C3C !important;
  border-radius: 40rpx !important;
  height: 76rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.btn-share-new {
  flex: 1;
  background: linear-gradient(135deg, #FFD93D, #F5A623) !important;
  color: #4A3728 !important;
  font-weight: bold !important;
  font-size: 26rpx !important;
  border-radius: 40rpx !important;
  height: 76rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #D4850D !important;
  box-shadow: 0 4rpx 12rpx rgba(245,166,35,0.3) !important;
}