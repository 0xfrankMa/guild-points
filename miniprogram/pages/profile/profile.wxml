<view class="container">
  <view class="user-card">
    <image class="user-avatar" wx:if="{{userInfo.avatar_url}}" src="{{userInfo.avatar_url}}" mode="aspectFill" />
    <view class="user-avatar user-avatar-default" wx:else>🦫</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname}}</text>
      <text class="user-role">{{roleLabel}}</text>
    </view>
    <view class="user-points">
      <text class="points-num">{{userInfo.points || 0}}</text>
      <text class="points-label">⭐ 积分</text>
    </view>
  </view>

  <view class="nickname-card">
    <view class="nickname-row">
      <text class="nickname-label">🎮 游戏昵称</text>
      <text class="nickname-value" wx:if="{{!editingNickname}}">{{userInfo.nickname}}</text>
      <input wx:else class="nickname-input" value="{{newNickname}}" bindinput="onNicknameInput" focus="true" />
    </view>
    <button size="mini" class="btn-edit-nickname" wx:if="{{!editingNickname}}" bindtap="startEditNickname">修改</button>
    <button size="mini" class="btn-save-nickname" wx:else bindtap="saveNickname">保存</button>
  </view>

  <view class="checkin-card">
    <view class="checkin-main" bindtap="doCheckin">
      <view class="checkin-left">
        <text class="checkin-icon">{{checkedIn ? '🙏' : '🦫'}}</text>
        <view>
          <text class="checkin-title">{{checkinSlogan}}</text>
          <text class="checkin-desc">{{checkedIn ? '今日已膜拜 +1积分' : '每日膜拜获得1积分'}}</text>
        </view>
      </view>
      <view class="checkin-right">
        <text class="checkin-streak" wx:if="{{checkinStreak > 0}}">连续{{checkinStreak}}天</text>
        <text class="checkin-btn {{checkedIn ? 'done' : ''}}">{{checkedIn ? '已膜拜' : '膜拜'}}</text>
      </view>
    </view>
    <view class="checkin-edit" wx:if="{{isAdmin}}" catchtap="editSlogan">
      <text class="checkin-edit-text">✏️ 修改词条</text>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{userInfo.total_earned || 0}}</text>
      <text class="stat-label">⬆️ 累计获得</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{userInfo.total_spent || 0}}</text>
      <text class="stat-label">⬇️ 累计消费</text>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">🏆 积分排行</text>
  </view>
  <view class="rank-list">
    <view class="rank-item" wx:for="{{rankings}}" wx:key="_id">
      <text class="rank-medal">{{index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : index + 1}}</text>
      <text class="rank-name">{{item.nickname}}</text>
      <text class="rank-points">{{item.total_earned}} ⭐</text>
    </view>
  </view>

  <view class="invite-card" wx:if="{{inviteCode}}">
    <view class="invite-header">
      <text class="invite-icon">🏰</text>
      <text class="invite-title">邀请好友加入工会</text>
    </view>
    <view class="invite-code-box">
      <text class="invite-code-label">邀请码</text>
      <text class="invite-code-value">{{inviteCode}}</text>
    </view>
    <view class="invite-btns">
      <button class="btn-copy-new" bindtap="copyInviteCode">📋 复制邀请码</button>
      <button class="btn-share-new" open-type="share">📨 发送给好友</button>
    </view>
  </view>

  <view class="danger-zone">
    <button class="btn-leave" bindtap="leaveGuild">退出工会</button>
  </view>
</view>