.container { padding: 20rpx; }

.my-points {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.points-num { font-weight: bold; color: #f57c00; font-size: 36rpx; }

.reward-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reward-name { display: block; font-size: 30rpx; font-weight: 500; margin-bottom: 8rpx; }
.reward-type { font-size: 24rpx; color: #666; }
.reward-stock { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

.reward-action { text-align: right; }
.reward-cost { display: block; font-size: 28rpx; color: #f57c00; font-weight: bold; margin-bottom: 8rpx; }

.btn-exchange {
  background: #1a73e8 !important;
  color: #fff !important;
}

.section-header { margin-top: 30rpx; margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: bold; }

.exchange-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ex-name { flex: 1; font-size: 28rpx; }
.ex-cost { font-size: 26rpx; color: #999; margin-right: 16rpx; }
.ex-status { font-size: 24rpx; }
.ex-status.pending { color: #ff9800; }
.ex-status.fulfilled { color: #4caf50; }
.ex-status.cancelled { color: #999; }

.empty { text-align: center; padding: 80rpx; color: #999; }
