.container { padding: 20rpx; }

.points-card {
  background: linear-gradient(135deg, #FFD93D 0%, #F5A623 50%, #FF8C00 100%);
  border-radius: 28rpx;
  padding: 40rpx;
  color: #4A3728;
  margin-bottom: 20rpx;
  border: 3rpx solid #D4850D;
  box-shadow: 0 8rpx 28rpx rgba(245,166,35,0.35);
  position: relative;
  overflow: hidden;
}

.card-deco {
  position: absolute;
  top: 10rpx;
  right: 20rpx;
  font-size: 80rpx;
  opacity: 0.2;
  transform: rotate(-15deg);
}

.points-label { font-size: 26rpx; opacity: 0.8; }
.points-value {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  margin: 10rpx 0;
  text-shadow: 2rpx 2rpx 0 rgba(255,255,255,0.4);
}

.points-stats {
  display: flex;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(74,55,40,0.15);
}

.stat-value { display: block; font-size: 32rpx; font-weight: bold; }
.stat-label { font-size: 22rpx; opacity: 0.7; }

.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  flex: 1;
  background: #FFFDF5;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4A3728;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.1);
  border: 2rpx solid #F0D68A;
  transition: all 0.2s;
}

.action-icon {
  display: block;
  font-size: 56rpx;
  margin-bottom: 10rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title { font-size: 32rpx; font-weight: bold; color: #4A3728; }
.task-count { font-size: 24rpx; color: #8B6914; background: #FFF3D6; padding: 4rpx 16rpx; border-radius: 20rpx; }

.task-card {
  background: #FFFDF5;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(139,105,20,0.08);
  border: 2rpx solid #F0D68A;
  border-left: 10rpx solid #F5A623;
}

.task-card.completed {
  opacity: 0.5;
  border-left-color: #4CAF50;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-title { font-size: 30rpx; font-weight: 500; flex: 1; color: #4A3728; }
.task-points { font-size: 30rpx; font-weight: bold; color: #FF8C00; white-space: nowrap; margin-left: 12rpx; }

.task-meta { display: flex; gap: 16rpx; align-items: center; }

.verify-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #FFF3D6;
  color: #D4850D;
  border: 1rpx solid #F0D68A;
}

.verify-tag.screenshot { background: #FFE8CC; color: #FF8C00; border-color: #FFB74D; }

.task-status { font-size: 24rpx; color: #4CAF50; font-weight: 500; }
.task-status.pending { color: #FF8C00; }

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #8B6914;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #4A3728;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #A0895C;
}
