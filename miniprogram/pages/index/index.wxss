.container { padding: 20rpx; }

.points-card {
  background: linear-gradient(135deg, #1a73e8, #0d47a1);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.points-label { font-size: 26rpx; opacity: 0.8; }
.points-value { display: block; font-size: 72rpx; font-weight: bold; margin: 10rpx 0; }

.points-stats {
  display: flex;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.stat-value { display: block; font-size: 32rpx; font-weight: bold; }
.stat-label { font-size: 22rpx; opacity: 0.7; }

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.action-icon { display: block; font-size: 48rpx; margin-bottom: 8rpx; }

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title { font-size: 32rpx; font-weight: bold; }
.task-count { font-size: 24rpx; color: #999; }

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.task-card.completed { opacity: 0.6; }

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-title { font-size: 30rpx; font-weight: 500; flex: 1; }
.task-points { font-size: 32rpx; font-weight: bold; color: #f57c00; }

.task-meta { display: flex; gap: 16rpx; align-items: center; }

.verify-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #e3f2fd;
  color: #1a73e8;
}

.verify-tag.screenshot { background: #fff3e0; color: #f57c00; }

.task-status { font-size: 24rpx; color: #4caf50; }
.task-status.pending { color: #ff9800; }

.empty {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
