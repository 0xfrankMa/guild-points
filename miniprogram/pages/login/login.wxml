<view class="login-page">
  <!-- Decorative bubbles -->
  <view class="deco-bubble b1"></view>
  <view class="deco-bubble b2"></view>
  <view class="deco-bubble b3"></view>

  <view class="logo-section">
    <view class="capybara-avatar">
      <text class="capybara-face">🦫</text>
      <view class="capybara-crown">👑</view>
    </view>
    <text class="app-title">工会积分</text>
    <text class="app-subtitle">✨ 完成任务 · 收集积分 · 赢取奖励 ✨</text>
  </view>

  <view class="tab-bar">
    <view class="tab {{tab === 'join' ? 'active' : ''}}" bindtap="switchTab" data-tab="join">🏰 加入工会</view>
    <view class="tab {{tab === 'create' ? 'active' : ''}}" bindtap="switchTab" data-tab="create">⚔️ 创建工会</view>
  </view>

  <view class="form" wx:if="{{tab === 'join'}}">
    <view class="input-group">
      <text class="label">🔑 邀请码</text>
      <input placeholder="输入工会邀请码" value="{{inviteCode}}" bindinput="onInviteCodeInput" />
    </view>
    <view class="input-group">
      <text class="label">🎮 游戏昵称</text>
      <input placeholder="输入你的游戏内昵称，方便管理员识别" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="avatar-group">
      <text class="label">📷 选择头像</text>
      <view class="avatar-pick">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" />
          <text wx:else class="avatar-placeholder">点击选择</text>
        </button>
      </view>
    </view>
    <button class="btn-primary" bindtap="joinGuild" loading="{{loading}}">加入工会 🚀</button>
  </view>

  <view class="form" wx:if="{{tab === 'create'}}">
    <view class="input-group">
      <text class="label">🏰 工会名称</text>
      <input placeholder="输入工会名称" value="{{guildName}}" bindinput="onGuildNameInput" />
    </view>
    <view class="input-group">
      <text class="label">🎮 会长游戏昵称</text>
      <input placeholder="输入你的游戏内昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="avatar-group">
      <text class="label">📷 选择头像</text>
      <view class="avatar-pick">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" />
          <text wx:else class="avatar-placeholder">点击选择</text>
        </button>
      </view>
    </view>
    <button class="btn-primary" bindtap="createGuild" loading="{{loading}}">创建工会 ⚔️</button>
  </view>

  <view class="footer-deco">
    <text>🌿🦫🌿🦫🌿🦫🌿</text>
  </view>
</view>
