.login-page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #FFD93D 0%, #F5A623 40%, #FF8C00 100%);
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 160rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.app-title {
  display: block;
  font-size: 60rpx;
  font-weight: bold;
  color: #4A3728;
  text-shadow: 2rpx 2rpx 0 rgba(255,255,255,0.3);
  margin-bottom: 10rpx;
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: #6B4E2A;
}

.tab-bar {
  display: flex;
  background: rgba(255,255,255,0.25);
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  padding: 6rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  color: #6B4E2A;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.tab.active {
  background: #fff;
  color: #D4850D;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.form {
  background: #FFFDF5;
  border-radius: 24rpx;
  padding: 40rpx;
  border: 3rpx solid #F0D68A;
  box-shadow: 0 8rpx 24rpx rgba(139,105,20,0.15);
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8B6914;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-group input {
  border: 2rpx solid #F0D68A;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  background: #FFF8E7;
}

.btn-primary {
  background: linear-gradient(135deg, #FFD93D 0%, #F5A623 100%) !important;
  color: #4A3728 !important;
  border-radius: 50rpx !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(245,166,35,0.4) !important;
  border: 2rpx solid #D4850D !important;
}
