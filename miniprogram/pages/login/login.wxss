.login-page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.app-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
}

.tab-bar {
  display: flex;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  color: rgba(255,255,255,0.7);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.tab.active {
  background: #fff;
  color: #1a73e8;
  font-weight: bold;
}

.form {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input-group input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
}

.btn-primary {
  background: #1a73e8 !important;
  color: #fff !important;
  border-radius: 12rpx !important;
  font-size: 32rpx !important;
  margin-top: 20rpx;
}
