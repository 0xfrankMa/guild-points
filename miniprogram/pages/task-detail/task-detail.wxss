.container { padding: 20rpx; }

.detail-card {
  background: #FFFDF5;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.1);
  position: relative;
}

.detail-badge {
  position: absolute;
  top: -20rpx;
  right: 24rpx;
  font-size: 48rpx;
  background: #FFFDF5;
  border-radius: 50%;
  width: 64rpx;
  height: 64rpx;
  text-align: center;
  line-height: 64rpx;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 8rpx rgba(139,105,20,0.1);
}

.detail-title { display: block; font-size: 36rpx; font-weight: bold; margin-bottom: 16rpx; color: #4A3728; }
.detail-desc { display: block; font-size: 28rpx; color: #6B4E2A; margin-bottom: 24rpx; line-height: 1.6; }

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 2rpx solid #F0D68A;
}

.detail-label { color: #8B6914; }
.detail-value { font-weight: 500; color: #4A3728; }
.detail-value.points { color: #FF8C00; font-size: 34rpx; font-weight: bold; }

.submit-section { margin-top: 20rpx; }

.screenshot-upload {
  background: #FFFDF5;
  border: 3rpx dashed #F0D68A;
  border-radius: 24rpx;
  padding: 70rpx 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.upload-icon { display: block; font-size: 72rpx; margin-bottom: 16rpx; }
.upload-text { color: #8B6914; font-size: 28rpx; }

.screenshot-preview {
  position: relative;
  margin-bottom: 20rpx;
}

.screenshot-preview image {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F0D68A;
}

.change-text {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(74,55,40,0.75);
  color: #FFD93D;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.btn-submit {
  background: linear-gradient(135deg, #FFD93D 0%, #F5A623 100%) !important;
  color: #4A3728 !important;
  border-radius: 50rpx !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  height: 88rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(245,166,35,0.5) !important;
  border: 2rpx solid #D4850D !important;
}

.btn-submit.btn-disabled {
  background: linear-gradient(135deg, #E0D5B8 0%, #C9B98A 100%) !important;
  color: #8B7D6B !important;
  border-color: #B8A87A !important;
  box-shadow: none !important;
}

.done-banner {
  background: linear-gradient(135deg, #81C784, #4CAF50);
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.3);
}

.section-header { margin-top: 30rpx; margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #4A3728; }

.submission-item {
  background: #FFFDF5;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  border: 2rpx solid #F0D68A;
}

.sub-time { font-size: 24rpx; color: #8B6914; }
.sub-status { font-size: 24rpx; font-weight: 500; }
.sub-status.approved { color: #4CAF50; }
.sub-status.pending { color: #FF8C00; }
.sub-status.rejected { color: #E74C3C; }
.sub-reason { width: 100%; font-size: 24rpx; color: #E74C3C; margin-top: 8rpx; }