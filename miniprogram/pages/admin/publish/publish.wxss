.container { padding: 30rpx; }

.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF3D6, #FFE8B8);
  border-radius: 24rpx;
  border: 2rpx solid #F0D68A;
}
.page-icon { font-size: 56rpx; }
.page-title { display: block; font-size: 34rpx; font-weight: bold; color: #4A3728; }
.page-subtitle { display: block; font-size: 24rpx; color: #8B6914; margin-top: 4rpx; }

.form-card {
  background: #FFFDF5;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.1);
}

.input-group { margin-bottom: 32rpx; }

.label {
  display: block;
  font-size: 28rpx;
  color: #8B6914;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.input-group input {
  border: 2rpx solid #F0D68A;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  background: #FFF8E7;
}

.input-group textarea {
  border: 2rpx solid #F0D68A;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  background: #FFF8E7;
}

.radio-group { display: flex; gap: 16rpx; }

.radio-item {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border: 2rpx solid #F0D68A;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8B6914;
  background: #FFF8E7;
}

.radio-item.active {
  border-color: #F5A623;
  color: #D4850D;
  background: linear-gradient(135deg, #FFF3D6, #FFE8B8);
  font-weight: bold;
}

.btn-publish {
  background: linear-gradient(135deg, #FFD93D 0%, #F5A623 100%) !important;
  color: #4A3728 !important;
  border-radius: 50rpx !important;
  font-weight: bold !important;
  font-size: 32rpx !important;
  margin-top: 30rpx;
  height: 88rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(245,166,35,0.4) !important;
  border: 2rpx solid #D4850D !important;
}