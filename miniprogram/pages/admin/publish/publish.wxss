.container { padding: 20rpx; }

.form-card {
  background: #FFFDF5;
  border-radius: 24rpx;
  padding: 36rpx;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.1);
}

.input-group { margin-bottom: 28rpx; }
.label { display: block; font-size: 26rpx; color: #8B6914; margin-bottom: 12rpx; font-weight: 500; }

.input-group input, .input-group textarea {
  border: 2rpx solid #F0D68A;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
  background: #FFF8E7;
}

.input-group textarea { height: 160rpx; }

.radio-group { display: flex; gap: 16rpx; }

.radio-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border: 2rpx solid #F0D68A;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8B6914;
  background: #FFF8E7;
}

.radio-item.active {
  border-color: #F5A623;
  color: #D4850D;
  background: linear-gradient(135deg, #FFF3D6, #FFE8B8);
  font-weight: bold;
}

.btn-publish {
  background: linear-gradient(135deg, #FFD93D 0%, #F5A623 100%) !important;
  color: #4A3728 !important;
  border-radius: 50rpx !important;
  font-weight: bold !important;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(245,166,35,0.4) !important;
  border: 2rpx solid #D4850D !important;
}