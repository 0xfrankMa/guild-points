.container { padding: 20rpx; }

.member-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx;
}
.member-info { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.member-name { font-size: 30rpx; font-weight: 500; }
.member-role {
  font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; background: #e0e0e0;
}
.member-role.master { background: #ffd700; color: #333; }
.member-role.admin { background: #e3f2fd; color: #1a73e8; }
.member-stats { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.member-actions { display: flex; gap: 12rpx; }
.btn-danger { background: #f44336 !important; color: #fff !important; }