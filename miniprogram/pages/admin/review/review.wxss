.container { padding: 20rpx; }

.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.select-all { font-size: 28rpx; }
.btn-batch { background: #4caf50 !important; color: #fff !important; }

.sub-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 16rpx;
}

.sub-check { padding-top: 4rpx; font-size: 36rpx; }
.sub-content { flex: 1; }
.sub-header { margin-bottom: 8rpx; }
.sub-user { font-weight: 500; margin-right: 16rpx; }
.sub-task { font-size: 26rpx; color: #666; }
.sub-points { font-size: 26rpx; color: #f57c00; margin-bottom: 12rpx; display: block; }

.sub-screenshot {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #f5f5f5;
}

.sub-actions { display: flex; gap: 16rpx; }
.btn-approve { background: #4caf50 !important; color: #fff !important; }
.btn-reject { background: #f44336 !important; color: #fff !important; }

.empty { text-align: center; padding: 80rpx; color: #999; }