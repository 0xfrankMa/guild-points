.container { padding: 20rpx; }

.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFDF5;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #F0D68A;
}

.select-all { font-size: 28rpx; color: #4A3728; }
.btn-batch {
  background: linear-gradient(135deg, #81C784, #4CAF50) !important;
  color: #fff !important;
  font-weight: bold !important;
  border-radius: 30rpx !important;
}

.sub-card {
  background: #FFFDF5;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 16rpx;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 12rpx rgba(139,105,20,0.08);
}

.sub-check { padding-top: 4rpx; font-size: 36rpx; color: #F5A623; }
.sub-content { flex: 1; }
.sub-header { margin-bottom: 8rpx; }
.sub-user { font-weight: 500; margin-right: 16rpx; color: #4A3728; }
.sub-task { font-size: 26rpx; color: #8B6914; }
.sub-points { font-size: 26rpx; color: #FF8C00; margin-bottom: 12rpx; display: block; font-weight: 500; }

.sub-screenshot {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #FFF8E7;
  border: 2rpx solid #F0D68A;
}

.sub-actions { display: flex; gap: 16rpx; }
.btn-approve {
  background: linear-gradient(135deg, #81C784, #4CAF50) !important;
  color: #fff !important;
  font-weight: bold !important;
  border-radius: 30rpx !important;
}
.btn-reject {
  background: linear-gradient(135deg, #EF5350, #E74C3C) !important;
  color: #fff !important;
  font-weight: bold !important;
  border-radius: 30rpx !important;
}

.empty { text-align: center; padding: 80rpx; color: #8B6914; }