.container { padding: 20rpx; }

.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF3D6, #FFE8B8);
  border-radius: 24rpx;
  border: 2rpx solid #F0D68A;
}
.page-icon { font-size: 56rpx; }
.page-title { display: block; font-size: 34rpx; font-weight: bold; color: #4A3728; }
.page-subtitle { display: block; font-size: 24rpx; color: #8B6914; margin-top: 4rpx; }

.form-card {
  background: #FFFDF5; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid #F0D68A; box-shadow: 0 4rpx 12rpx rgba(139,105,20,0.1);
}
.form-title { display: block; font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; color: #4A3728; }

.input-row { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.input-row input {
  flex: 1; border: 2rpx solid #F0D68A; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; background: #FFF8E7;
}
.input-row .short { max-width: 200rpx; }

.radio-group { display: flex; gap: 8rpx; flex: 1; }
.radio-item {
  flex: 1; text-align: center; padding: 16rpx; border: 2rpx solid #F0D68A;
  border-radius: 12rpx; font-size: 26rpx; color: #8B6914; background: #FFF8E7;
}
.radio-item.active { border-color: #F5A623; color: #D4850D; background: #FFF3D6; font-weight: bold; }

.btn-add {
  background: linear-gradient(135deg, #FFD93D, #F5A623) !important;
  color: #4A3728 !important; font-weight: bold !important;
  border-radius: 30rpx !important; margin-top: 12rpx;
  border: 2rpx solid #D4850D !important;
}

.section-header { margin: 20rpx 0 12rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #4A3728; }

.ex-card {
  background: #FFFDF5; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center;
  border: 2rpx solid #F0D68A; gap: 16rpx;
}
.ex-card view:first-child { flex: 1; min-width: 0; }
.ex-user { font-weight: 500; margin-right: 12rpx; color: #4A3728; }
.ex-reward { font-size: 26rpx; color: #8B6914; }
.btn-fulfill {
  background: linear-gradient(135deg, #81C784, #4CAF50) !important;
  color: #fff !important; font-weight: bold !important; border-radius: 30rpx !important;
  flex-shrink: 0; white-space: nowrap;
}

.reward-item {
  background: #FFFDF5; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center;
  border: 2rpx solid #F0D68A;
}
.r-name { display: block; font-weight: 500; color: #4A3728; }
.r-info { font-size: 24rpx; color: #8B6914; }