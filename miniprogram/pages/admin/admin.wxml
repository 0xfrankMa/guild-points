<view class="container">
  <view class="admin-menu">
    <view class="menu-item" bindtap="goTo" data-page="publish">
      <text class="menu-icon">📝</text>
      <view class="menu-text">
        <text class="menu-title">发布任务</text>
        <text class="menu-desc">创建新的日常/活动任务</text>
      </view>
    </view>
    <view class="menu-item" bindtap="goTo" data-page="review">
      <text class="menu-icon">✅</text>
      <view class="menu-text">
        <text class="menu-title">审核队列</text>
        <text class="menu-desc">审核成员提交的截图</text>
      </view>
      <text class="badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</text>
    </view>
    <view class="menu-item" bindtap="goTo" data-page="rewards">
      <text class="menu-icon">🎁</text>
      <view class="menu-text">
        <text class="menu-title">商城管理</text>
        <text class="menu-desc">管理兑换商品和发放奖励</text>
      </view>
    </view>
    <view class="menu-item" bindtap="goTo" data-page="members" wx:if="{{isMaster}}">
      <text class="menu-icon">👥</text>
      <view class="menu-text">
        <text class="menu-title">成员管理</text>
        <text class="menu-desc">管理工会成员和角色</text>
      </view>
    </view>
  </view>
</view>