.container { padding: 20rpx; }

.admin-header {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.admin-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #4A3728;
  margin-bottom: 8rpx;
}

.admin-subtitle {
  font-size: 24rpx;
  color: #8B6914;
}

.menu-item {
  background: #FFFDF5;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  position: relative;
  border: 2rpx solid #F0D68A;
  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.08);
}

.menu-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  background: #FFF3D6;
  border-radius: 20rpx;
  text-align: center;
  line-height: 72rpx;
}

.menu-text { flex: 1; }
.menu-title { display: block; font-size: 30rpx; font-weight: 600; color: #4A3728; margin-bottom: 4rpx; }
.menu-desc { font-size: 24rpx; color: #8B6914; }

.menu-arrow {
  font-size: 36rpx;
  color: #D4850D;
  font-weight: bold;
}

.badge {
  background: linear-gradient(135deg, #E74C3C, #C0392B);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  min-width: 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(231,76,60,0.3);
}